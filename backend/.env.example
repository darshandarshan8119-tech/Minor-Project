DJANGO_SETTINGS_MODULE=agrimart.settings
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_URL=postgres://agrimart:agrimart_dev_password@localhost:5432/agrimart
REDIS_URL=redis://localhost:6379/0
JWT_ISSUER=agrimart
JWT_AUDIENCE=agrimart-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
FIELD_ENCRYPTION_KEYS=dev-key-id:dev-32-byte-placeholder-key!!!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Market Copilot (server-side only; never put API keys in the frontend)
MARKET_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MARKET_LLM_TEMPERATURE=0.2
MARKET_LLM_MAX_TOKENS=1500
MARKET_LLM_TIMEOUT_SECONDS=25

# Crop Clinic local image assessment via Ollama (use the exact tag installed locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
